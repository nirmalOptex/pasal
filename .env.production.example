# ─────────────────────────────────────────────────────────────────────────────
# ChiyaPasal POS — Production Environment Variables
# Copy this file to .env.production and fill in your values.
# NEVER commit .env.production to version control.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=chhiyapasal

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_64_RANDOM_CHARS
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to your frontend domain once deployed, e.g. https://pos.mycafe.com
# Leave empty to allow all origins (not recommended for production).
FRONTEND_URL=

# ── Frontend serving ─────────────────────────────────────────────────────────
# Set to true if the API should also serve the built React frontend
# (convenient for single-server setups)
SERVE_FRONTEND=false
