# ─────────────────────────────────────────────────────────────────────────────
# ChiyaPasal POS — Production Environment Variables
# For Free Tier Production Deployment (Render + Supabase + Vercel)
# In Render: configure these as Environment Variables in the Render Dashboard.
# NEVER commit real passwords or secret keys to version control.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# ── Server ───────────────────────────────────────────────────────────────────
# Render sets PORT dynamically (usually 10000). Leave default or let Render inject it.
PORT=10000

# ── Database (Supabase PostgreSQL) ───────────────────────────────────────────
# Option A: Individual parameters (recommended for Render & TypeORM):
# In Supabase: Project Settings -> Database -> Connection Parameters
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_USER=postgres.your-project-ref
DB_PASSWORD=your_supabase_db_password
DB_NAME=postgres

# Remote hosted databases (Supabase) require SSL:
DB_SSL=true
# Set to 'false' only if your provider requires bypassing CA verification
DB_SSL_REJECT_UNAUTHORIZED=true

# Option B: Complete Connection String (optional, overrides individual params if set):
# DATABASE_URL=postgresql://postgres.your-project-ref:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate strong 64-character hex strings:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=generate_a_secure_random_64_character_hex_string_here
JWT_REFRESH_SECRET=generate_another_secure_random_64_character_hex_string
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
# The URL of your deployed Vercel frontend (without trailing slash).
# Multiple domains can be comma-separated, e.g.:
# FRONTEND_URL=https://your-chhiyapasal.vercel.app,http://localhost:5173
FRONTEND_URL=https://your-chhiyapasal.vercel.app

# ── Logging ───────────────────────────────────────────────────────────────────
# In cloud platforms like Render, stdout/stderr is captured automatically.
# Set to 'true' only if you are deploying to a server with local persistent disk (PM2).
ENABLE_FILE_LOGGING=false

# ── Optional: Serve built frontend from Express ───────────────────────────────
# Set to 'false' when using Vercel for frontend.
SERVE_FRONTEND=false
