# ─────────────────────────────────────────────────────────────────
# ChiyaPasal Web — Production Environment Variables
# For Vercel Deployment: set VITE_API_URL in the Vercel Dashboard
# under Project Settings -> Environment Variables.
# NEVER place backend secrets (DB passwords, JWT secrets) here.
# ─────────────────────────────────────────────────────────────────

# The URL of your deployed Render backend:
# e.g. https://chhiyapasal-api.onrender.com/api/v1
VITE_API_URL=https://your-backend.onrender.com/api/v1
