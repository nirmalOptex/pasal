# ─────────────────────────────────────────────────────────────────
# ChiyaPasal Web — Production Environment Variables
# Copy this to .env.production and fill in your API URL.
# NEVER commit .env.production to version control.
# ─────────────────────────────────────────────────────────────────

# The full base URL of your API server (no trailing slash)
# e.g. https://api.mycafe.com/api/v1  OR  http://192.168.1.10:4000/api/v1
VITE_API_URL=http://localhost:4000/api/v1
