{
  "name": "chhiyapasal",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "build:shared": "npm run build --workspace=packages/shared-types",
    "build:api": "npm run build:shared && npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "build": "npm run build:api && npm run build:web",
    "start": "pm2 start ecosystem.config.js --env production",
    "start:api": "node apps/api/dist/main.js",
    "stop": "pm2 stop chhiyapasal-api",
    "restart": "pm2 restart chhiyapasal-api",
    "logs": "pm2 logs chhiyapasal-api",
    "migration:generate": "npm run migration:generate --workspace=apps/api",
    "migration:run": "npm run migration:run --workspace=apps/api",
    "migration:revert": "npm run migration:revert --workspace=apps/api",
    "seed": "npm run seed --workspace=apps/api"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "pm2": "^5.4.2"
  }
}
